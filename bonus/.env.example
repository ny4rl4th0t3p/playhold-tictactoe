# Copy this to .env, next to compose.prod.yaml, and change it. .env holds a password: never commit it.

# On your own machine: names ending in .localhost reach this machine, and Caddy makes its own certificate for them,
# which the browser warns about once for each name. A port above 1024 needs no root. Open https://GAME_ADDRESS/healthz
# once and accept its certificate, or the page can't connect: a page's own connection can't show the warning.
PAGE_ADDRESS=page.localhost:8443
GAME_ADDRESS=game.localhost:8443
PORT=8443
LOCAL_CERTS=local_certs

# On another machine of your own network, such as a virtual machine: browsers keep .localhost names to the machine
# they run on, so use names ending in .test, which never exist on the internet, and add both to the hosts file of the
# machine you browse from, pointing at this one's address, such as "192.168.1.20 page.tictactoe.test game.tictactoe.test".
# Accept GAME_ADDRESS's certificate at /healthz once, as above.
# PAGE_ADDRESS=page.tictactoe.test:8443
# GAME_ADDRESS=game.tictactoe.test:8443
# PORT=8443
# LOCAL_CERTS=local_certs

# On a server with a domain: both names point at it in DNS, and port 443 is open. Caddy gets the certificates from
# Let's Encrypt, so LOCAL_CERTS stays empty.
# PAGE_ADDRESS=page.example
# GAME_ADDRESS=game.example
# PORT=443
# LOCAL_CERTS=

# PostgreSQL's password, only reachable inside the Compose network. Use a long random one.
POSTGRES_PASSWORD=change-me